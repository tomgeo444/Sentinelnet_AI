# SentinelNet AI Configuration
# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database (MariaDB / MySQL or SQLite fallback)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sentinel
DB_PASSWORD=sentinel_secure_pass
DB_NAME=sentinelnet_db
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=sqlite:///./sentinelnet.db

# Live Network Capture
# Leave blank to auto-detect the default active interface (e.g. lo, eth0, wlan0, wlp0s20f3)
NETWORK_INTERFACE=
SERVER_PORT_FILTER=8000
FLOW_IDLE_TIMEOUT=2.0
FLOW_ACTIVE_TIMEOUT=10.0

# Deep Learning Model & Artifacts
MODEL_PATH=models/sentinelnet_model.pt
SCALER_PATH=models/scaler.joblib
LABEL_ENCODER_PATH=models/label_encoder.joblib
FEATURE_NAMES_PATH=models/feature_names.json
METRICS_PATH=models/model_metrics.json

# Risk Engine Thresholds
RISK_THRESHOLD_LOW=0.40
RISK_THRESHOLD_MEDIUM=0.65
RISK_THRESHOLD_HIGH=0.85
RISK_THRESHOLD_CRITICAL=0.95
